# 数据库连接字符串 (MongoDB)
DATABASE_URL="mongodb://mongo:27017/rental_platform"

# JWT 密钥 (请使用强随机字符串)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT 过期时间
JWT_EXPIRES_IN="7d"

# RSA 密钥对 (Base64 编码的 PEM 格式，用于登录/注册密码加密传输)
# 可通过以下命令生成:
# node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('RSA_PUBLIC_KEY_BASE64='+Buffer.from(publicKey).toString('base64'));console.log('RSA_PRIVATE_KEY_BASE64='+Buffer.from(privateKey).toString('base64'))"
RSA_PUBLIC_KEY_BASE64=""
RSA_PRIVATE_KEY_BASE64=""
