# ============================================
# 根目录 .gitignore
# 包含所有子项目需要忽略的文件
# ============================================

# ==================== Dependencies ====================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ==================== Build Output ====================
# Next.js
.next/
**/.next/
out/
**/out/

# Production
build/
**/build/
dist/
**/dist/

# ==================== Environment Variables ====================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# 保留示例文件
!.env.example
!**/.env.example

# ==================== IDE / Editor ====================
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ==================== OS Files ====================
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ==================== Debug / Logs ====================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==================== Testing ====================
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# ==================== TypeScript ====================
*.tsbuildinfo
next-env.d.ts

# ==================== Prisma ====================
**/prisma/migrations/

# ==================== Misc ====================
*.pem
*.key
*.cert

# ==================== Docker ====================
# 不忽略 Dockerfile 和 docker-compose.yml
# 忽略 Docker 生成的文件
.docker/

# ==================== Vercel ====================
.vercel
**/.vercel
